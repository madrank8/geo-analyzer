# GEO Analyzer — Environment Variables
# Copy this to .env and fill in your values

# Required: JWT secret (generate a random string)
JWT_SECRET=change-me-to-something-random

# Optional: Google API keys for enhanced analysis
# The app works without these — they add NLP, Knowledge Graph, and Gemini enrichment
GOOGLE_KG_KEY=
GOOGLE_PLACES_KEY=
GOOGLE_NLP_KEY=
GOOGLE_GEMINI_KEY=
